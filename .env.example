# ============================================================================
# clip2text —— 全部留空也能完整运行「贴链接/传文件 → 转写 → 导出」主链路
# 复制为 .env 后按需填写；未填写的项会在 /api/v1/capabilities 中报告为不可用
# ============================================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# 数据目录（数据库、上传文件、模型缓存、导出产物）
DATA_DIR=./.data

# ---------- 并发控制 ----------
# 全局同时处理的任务数
MAX_CONCURRENCY=2
# 单次批量提交上限
MAX_BATCH_SIZE=100

# ---------- 媒体处理 ----------
# auto | system | static —— auto 优先用系统 ffmpeg，找不到则用 static-ffmpeg 自动下载
FFMPEG_MODE=auto
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=300
# 音频分片上限（秒）。DeepSeek ASR 单次最多 120s，所以默认 110
CHUNK_MAX_SEC=110

# ---------- ASR 语音转文字 ----------
# auto | mlx | faster-whisper | funasr | deepseek
# auto: 按本机环境自动挑选（Apple Silicon 优先 mlx，其他优先 faster-whisper）
ASR_ENGINE=auto
ASR_MODEL=large-v3-turbo
ASR_LANGUAGE=
# 留空则自动检测；中文场景建议填 zh

# ---------- OCR 图片文字 ----------
# auto | rapidocr | deepseek
OCR_ENGINE=auto

# ---------- LLM 文案改写（可选）----------
# 走 OpenAI 兼容协议，可指向 Ollama / vLLM / DeepSeek / 任意兼容服务
# 留空则前端隐藏「AI 改写」入口
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- 云服务（可选，共用同一个 DeepSeek key）----------
# 填了之后 ASR_ENGINE / OCR_ENGINE 可以设为 deepseek 走云端
DEEPSEEK_API_KEY=

# ---------- 平台链接解析（默认开启）----------
# 这个工具的主入口是「贴一条链接 → 出文字」：长视频播客、知识科普、
# 读书、讲座。所以默认开启，装完就能用。
# 如需完全关闭（合规兜底），设为 false；关闭后 /tasks 会拒绝 url 类型来源。
EXTRACTORS_ENABLED=true
# 可选：单平台开关，逗号分隔。留空表示全部启用
# 可写适配器短名：bilibili / xiaoyuzhou / podcastfeed / ytdlp
EXTRACTORS_ALLOW=
# 可选：代理，抓取风控严格的平台时可能需要
PROXY_URL=
# 可选：个别平台需要的登录态 Cookie（不要提交到 git）
COOKIE_FILE=

# ---------- 长内容护栏 ----------
# 3 小时播客会切成上百个片段，中途失败代价很高，所以超限直接拒绝而不是慢慢跑死。
# 设为 0 表示不限制（自建机器上想跑超长内容时用）。
MAX_MEDIA_DURATION_MIN=180
MAX_MEDIA_SIZE_MB=2048

# ---------- 分片级重试 ----------
# 2 小时播客切成 70 段，中间任一段失败就整任务作废太浪费。
# 每段最多重试 CHUNK_RETRY_MAX 次，退避按 1x / 2x / 4x 指数增长。
CHUNK_RETRY_MAX=2
CHUNK_RETRY_BACKOFF_SEC=1.0

# ---------- 断点续跑 ----------
# 每段转写结果落盘到 .data/work/<task_id>/checkpoint.json。
# 进程重启后重新提交同一链接会跳过已完成的分片，而不是从头再跑一遍。
RESUME_ENABLED=true

# ---------- 用量估算单价（可选）----------
# 这些只是**估算**用的单价，真实账单以各服务商为准。
# 单位：元/小时音频、元/张图、元/百万 token。
# 默认值见 config.DEFAULT_PRICING；想改请在网页「设置 → 用量」里改，
# 会写进 .data/settings.json 的 pricing 字段（优先级高于本文件）。
# 若确实要用环境变量，pricing 是 dict，需要写成 JSON 字符串：
# PRICING={"asr_per_hour":0.78,"ocr_per_image":0.0015,"llm_input_per_mtok":1.0,"llm_output_per_mtok":4.0}

# ---------- 前端可配置 key 的位置（说明，不是环境变量）----------
# 在网页右上角齿轮里填的 API Key 存在 .data/settings.json（权限 0600），
# 优先级高于 .env，保存后**立即生效、无需重启**。
# 想清空界面配置、回落到这里的 .env 值：点「清除」或删除该文件。

# ---------- HuggingFace 镜像（国内必配）----------
# huggingface.co 在国内经常 SSL 中断，导致模型下载失败。
# 配了之后模型就能正常下载；首次运行前设置即可。
HF_ENDPOINT=https://hf-mirror.com
# 已下载过模型时自动进入离线模式（本项目自动处理，一般不用手改）
# HF_HUB_OFFLINE=0
